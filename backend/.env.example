# Local development
APP_NAME=AI Pulse Korea API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_news_portal

# Optional Cloud SQL connector mode
USE_CLOUD_SQL_CONNECTOR=false
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_IP_TYPE=PUBLIC

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Crawl settings
HTTP_TIMEOUT_SECONDS=20
USER_AGENT=AI-Pulse-Korea/0.1 (+https://example.com)
DEFAULT_FETCH_LIMIT=12

# Runtime
FRONTEND_BASE_URL=http://localhost:3000
ADMIN_TOKEN=change-me
